{
  "name": "nextjs-blog",
  "version": "0.1.0",
  "description": "A modern, customizable blog template built with Next.js and Nextra",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0nyz0/nextjs-blog.git"
  },
  "author": "t0nyz0 (Github)",
  "dependencies": {
    "next": "^16.3.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "zod": "~4.3.6"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "^0.9.12",
      "zod": "~4.3.6"
    }
  }
}
